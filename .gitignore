__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.venv/
venv/
node_modules/
.next/
out/

# Secrets. Never.
.env
.env.*
!.env.example
*.key
*.pem

# Run artefacts. results.json / results.md / exceptions.xlsx ARE committed,
# because the README cites their numbers and a reader must be able to check.
eval/results/*.sqlite
eval/results/paused/

# Local agent/editor config
.claude/

# Scratch, CI and live eval outputs; only published tags are committed.
eval/results/results-scratch.*
eval/results/results-ci.*
eval/results/results-live.*
eval/results/exceptions-*.xlsx
eval/results/traces-*.json
