# ERPNext. Generate the key/secret in ERPNext:
#   User > Administrator > API Access > Generate Keys
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# LLM. Any OpenAI-compatible endpoint. Groq's free tier serves a
# tool-calling Llama 3.3 70B, which is why it is the default.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Anthropic instead:
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_MODEL=claude-opus-5-5
# OpenAI instead:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o

PF_COMPANY=ProcureFlow Demo Pvt Ltd
PF_ABBR=PFD
PF_WAREHOUSE=Stores - PFD
PF_RUN_CEILING=50000000
PF_TRACE_DB=eval/results/traces.sqlite

# --- v3 controls -------------------------------------------------------------
# Buying price list R14 values unpriced lines from and checks quotes against.
PF_PRICE_LIST=Standard Buying
# Kill switch: "off" refuses every ERP write at the tool boundary (R8).
PROCUREFLOW_WRITES=on
# API identity: token=identity pairs. The identity is a person for /runs and an
# R12 approver id for /approve. No tokens configured = every write refused.
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(24))"
PF_API_TOKENS=
# Origins allowed to call the API from a browser (the dashboard).
PF_CORS_ORIGINS=http://localhost:8123
# The only folder the API reads source documents from.
PF_INBOX=seed/samples
# Key that signs paused runs on disk. Empty = generated once into
# eval/results/paused/.state.key (git-ignored).
PF_STATE_KEY=
